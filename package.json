{
  "name": "islm-macroeconomic-simulator",
  "private": true,
  "version": "0.1.0",
  "description": "An interactive macroeconomic simulation platform for exploring IS-LM equilibrium, monetary and fiscal policy transmission, interest rate dynamics, and comparative statics through mathematical modeling and real-time visualizations.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "validate": "npm run typecheck && npm run lint && npm run test && vite build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.2.7",
    "d3-scale": "4.0.2",
    "d3-shape": "3.2.0",
    "katex": "0.19.0",
    "react": "19.1.10",
    "react-dom": "19.1.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.0",
    "@types/d3-scale": "4.0.9",
    "@types/d3-shape": "3.1.7",
    "@types/katex": "0.16.8",
    "@types/node": "22.18.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.40.0",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
